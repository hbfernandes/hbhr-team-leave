{
  "manifest_version": 3,
  "name": "HBHR Team Leave",
  "description": "Local, read-only team leave timelines and overlap summaries inside your HBHR dashboard.",
  "version": "0.1.2",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "minimum_chrome_version": "120",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://app.hbhr.io/*"
      ],
      "js": [
        "transition.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://app.hbhr.io/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
